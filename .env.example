# Wallet to watch and mirror (defaults to this if unset)
WATCH_WALLET=0xb5de863cfef62edecbf1f0e39d0c6acc82df2c54

# How often to poll the Data API for new trades (ms)
POLL_INTERVAL_MS=5000

# Starting paper bankroll for demo mode
DEMO_CAPITAL=2000

# Mirror sizing: bot's target position size = master's current size * this fraction
MIRROR_SCALE=0.01

# Optional — if set, ignore MIRROR_SCALE and always target this flat share count
# whenever master holds any amount > 0 (target drops to 0, i.e. bot closes,
# once master's size hits 0)
# MIRROR_FIXED_SHARES=5

# Ignore position-size deltas smaller than this many shares (dust/rounding)
MIN_MIRROR_SHARES=0.5

# If true, positions the master wallet already has open the first time the
# bot polls are immediately mirrored as opens. If false, only future
# opens/adds/reduces/closes are mirrored.
MIRROR_EXISTING_ON_START=true

# Max positions to pull per poll from the Data API /positions endpoint
POSITIONS_LIMIT=500

# How many recent raw trade rows to pull for the (display-only) source feed
ACTIVITY_LIMIT=40

PORT=8080
