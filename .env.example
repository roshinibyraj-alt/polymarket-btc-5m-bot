# ── Polymarket Perps mirroring ─────────────────────────────
# Perps wallet to watch and mirror. All reads are PUBLIC — no key needed.
# Accepts a perps account address (0x...) or a profile username (@name).
# Default: the perps wallet behind the profitable profile @abc9901.
WATCH_WALLET=0x2070f45c22e44a52cb42210d1112a0bfb6a9a0c7

# How often to poll the perps portfolio + tickers (ms)
POLL_INTERVAL_MS=5000

# Starting paper bankroll for demo mode. With MIRROR_SCALE=0.01 this master
# (≈$1.5M portfolio) needs ≈$15-20k to mirror all 29 positions.
DEMO_CAPITAL=20000

# Mirror sizing: bot's target size = |master size| * this fraction
MIRROR_SCALE=0.01

# Optional — if set, ignore MIRROR_SCALE and always target this flat
# magnitude whenever master holds any amount > 0 (direction still mirrors)
# MIRROR_FIXED_SIZE=0.01

# Ignore position-size deltas smaller than this magnitude (dust/rounding)
MIN_MIRROR_SIZE=0.0001

# If true, positions the master wallet already has open the first time the
# bot polls are immediately mirrored as opens. If false, only future
# opens/adds/reduces/closes are mirrored.
MIRROR_EXISTING_ON_START=true

PORT=8080
