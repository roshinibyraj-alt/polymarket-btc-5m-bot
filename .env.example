# Wallet to watch and mirror (defaults to this if unset)
WATCH_WALLET=0xb5de863cfef62edecbf1f0e39d0c6acc82df2c54

# How often to poll the Data API for new trades (ms)
POLL_INTERVAL_MS=5000

# Starting paper bankroll for demo mode
DEMO_CAPITAL=2000

# Mirror sizing: copy this fraction of the source wallet's share size (0.01 = 1%)
MIRROR_SCALE=0.01

# Optional — if set, ignore MIRROR_SCALE and always mirror this flat share count instead
# MIRROR_FIXED_SHARES=5

# Skip mirroring trades that would round down below this many shares
MIN_MIRROR_SHARES=1

# How many recent activity rows to pull per poll
ACTIVITY_LIMIT=100

PORT=8080
